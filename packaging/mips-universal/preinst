#!/bin/sh

machine="$(uname -m 2>/dev/null || echo unknown)"
case "$machine" in
    mips*) ;;
    *)
        echo "e2xray: this universal IPK requires a MIPS receiver." >&2
        echo "Detected kernel architecture: $machine" >&2
        exit 1
        ;;
esac

case "$machine" in
    mipsel|mipsle|mips32el|mips32le|mips64el|mips64le)
        byte_order="little"
        ;;
    *)
        byte_order="$(
            awk -F: 'tolower($1) ~ /(byteorder|endianness|endian)/ {
                print tolower($2)
                exit
            }' /proc/cpuinfo 2>/dev/null || true
        )"
        ;;
esac

case "$byte_order" in
    *little*) ;;
    *big*)
        echo "e2xray: this IPK requires little-endian MIPS (mipsel/mips32el)." >&2
        exit 1
        ;;
    *)
        shell_path="$(readlink -f /bin/sh 2>/dev/null || echo /bin/sh)"
        elf_data="$(
            od -An -j 5 -N 1 -tu1 "$shell_path" 2>/dev/null |
                tr -d '[:space:]' || true
        )"
        if [ "$elf_data" = "2" ]; then
            echo "e2xray: big-endian MIPS is not supported by the bundled little-endian cores." >&2
            exit 1
        fi
        if [ "$elf_data" != "1" ]; then
            # BusyBox od frequently rejects the option form used above, so an
            # empty result means "could not tell", not "incompatible".
            # Big-endian MIPS receivers are vanishingly rare, and aborting here
            # blocked healthy boxes with an error the user could not act on.
            echo "e2xray: could not confirm MIPS byte order; assuming little-endian." >&2
        fi
        ;;
esac

exit 0
